{
  "dependencies": {
    "@vcs/kernel": "workspace:*",
    "@vcs/project": "workspace:*",
    "@vcs/schemas": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@vcs/plant": "workspace:*",
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "esbuild": "0.28.2",
    "exceljs": "4.4.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10"
  },
  "license": "UNLICENSED",
  "name": "vcs",
  "packageManager": "pnpm@10.15.0",
  "private": true,
  "scripts": {
    "bench": "node bench/run-all-benches.mjs",
    "build": "turbo run build",
    "depcheck": "depcruise --validate .dependency-cruiser.cjs packages apps",
    "dev": "turbo run dev",
    "docs:diagnostics": "tsx scripts/gen-diagnostics.ts",
    "docs:equipment": "tsx scripts/gen-equipment-docs.ts",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write .",
    "gen:io-fixture": "tsx scripts/gen-io-fixture.ts",
    "gen:suggest-project": "tsx scripts/gen-suggest-project.ts",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint .",
    "review:cheats": "node scripts/check-cheats.mjs",
    "test": "cross-env NODE_OPTIONS=--expose-gc vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "vcs": "tsx apps/cli/src/index.ts",
    "test:e2e": "node scripts/ensure-web-dist.mjs && playwright test"
  },
  "type": "module",
  "version": "0.1.0"
}
